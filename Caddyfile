# Адрес для писем Let's Encrypt об истечении сертификата не обязателен: без него
# всё работает, просто не будет напоминаний. Раньше здесь стоял блок с
# `email {$ACME_EMAIL}`, и при пустой переменной Caddy отказывался стартовать
# вовсе — то есть необязательная настройка роняла весь сервер.
# Если напоминания нужны, раскомментируйте:
# {
# 	email ваша@почта
# }

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
}

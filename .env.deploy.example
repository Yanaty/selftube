# Скопировать на сервере в .env и заполнить:  cp .env.deploy.example .env
# Домен должен уже указывать A-записью на IP этого сервера, иначе Caddy не
# получит сертификат. Почта для Let's Encrypt не нужна — при желании её можно
# вписать прямо в Caddyfile.
DOMAIN=selftube.example.com

# Логин и пароль родителя. Применяются только при первом создании базы;
# существующий пароль пересоздание контейнера не трогает.
SEED_PARENT_EMAIL=you@example.com
SEED_PARENT_PASSWORD=длинный-пароль-не-меньше-12-символов

# Необязательно: свой образ или конкретная версия вместо :latest
# APP_IMAGE=ghcr.io/yanaty/selftube:latest
